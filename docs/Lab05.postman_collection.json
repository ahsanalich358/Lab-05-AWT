{
  "info": {
    "name": "CSC337 Lab 05 Security Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read VIVA_AND_POSTMAN.md. Use HTTPS; cookie jar handles secure refresh cookie. Set baseUrl and origin for deployment."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3443/api/v1"
    },
    {
      "key": "origin",
      "value": "https://localhost:3443"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "payrollId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": \"acme\",\n  \"email\": \"employee@acme.test\",\n  \"password\": \"Lab05!DemoPass2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) { pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
